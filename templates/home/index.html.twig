<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Home</title>
</head>
<body>
    <h1>Home</h1>
    <p>Welcome to my website!</p>
    <p>This is a simple website that I created using Symfony.</p>

    <ul>
        {% for user in users %}
            <li style="color: {{ user.status == 'active' ? 'green' : 'red' }}">{{ user.name }} - {{ user.email }} - {{ user.age }}</li>
        {% endfor %}
    </ul>

    <twig:Alert title="Hello" message="This is a success message" type="success" />

    <a href="{{ path('app_show', {'id': 1}) }}">Show User 1</a>
    <a href="{{ path('app_show', {'id': 2}) }}">Show User 2</a>
    <a href="{{ path('app_show', {'id': 3}) }}">Show User 3</a>
</body>
</html>